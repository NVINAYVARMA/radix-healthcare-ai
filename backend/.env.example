# RadiX AI Backend Configuration

ENV=development
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Database URL (SQLite default for local development, PostgreSQL/Supabase for cloud)
DATABASE_URL=sqlite:///./radix.db

# Supabase Credentials (Optional for local testing)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Storage Backend: "local" or "supabase"
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/storage
SUPABASE_BUCKET_NAME=studies

# Firebase Configuration
FIREBASE_CREDENTIALS_PATH=./radix-ai-firebase-adminsdk-fbsvc-42c3bbb4d9.json
FIREBASE_PROJECT_ID=radix-ai
FIREBASE_STORAGE_BUCKET=radix-ai.appspot.com
ENABLE_FIREBASE_SYNC=True

# AI Provider: "densenet121" (final trained DenseNet121 model), "resnet18", "mock", or "real"
AI_PROVIDER=densenet121
AI_MODEL_WEIGHTS_PATH=./ml/reading_backlog_densenet121_best.pth
AI_SERVICE_URL=
AI_SERVICE_KEY=
